# Copy to `.env` on the VPS and fill in real values. Never commit `.env`.
# This file is read by docker-compose.prod.yaml.

# Versioning
IMAGE_TAG=v0.1.0
GH_OWNER=KiranCNayak
DOMAIN=planning-poker.knayak.dev

# Backend runtime
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
JWT_ACCESS_SECRET=change-me-32-bytes-min
JWT_REFRESH_SECRET=change-me-32-bytes-min
JWT_ANON_SECRET=change-me-32-bytes-min
JWT_ACCESS_EXPIRES_IN=2d
JWT_REFRESH_EXPIRES_IN=30d
FINGERPRINT_SALT=change-me-random
INVITE_CODE=change-me-shared-with-team
CORS_ORIGIN=https://planning-poker.knayak.dev
ROOM_CAPACITY_LIMIT=100
